+// Local evaluation only. Record the arguments accepted by the tool, including
+// catalogs supplied through a profile, separately from Codex's shell trace.
+func recordTrialInvocation(_ argv: [String], resolved: VizArguments?) {
+    guard !argv.isEmpty, argv != ["--version"] else { return }
+    guard let executable = Bundle.main.executableURL else {
+        fail("Could not locate the trial executable for invocation logging", code: 2)
+    }
+    let trace = executable.resolvingSymlinksInPath().deletingLastPathComponent()
+        .appendingPathComponent("output/.ontologyviz-invocations.jsonl")
+    let row: [String: Any] = [
+        "argv": argv,
+        "parsed": resolved != nil,
+        "format": resolved.map { $0.format.rawValue as Any } ?? NSNull(),
+        "catalogs": resolved?.diagram.foundationModels.map {
+            $0.url.resolvingSymlinksInPath().path
+        } ?? [],
+    ]
+    do {
+        var data = try JSONSerialization.data(withJSONObject: row, options: [.sortedKeys])
+        data.append(0x0A)
+        if !FileManager.default.fileExists(atPath: trace.path) {
+            try Data().write(to: trace)
+        }
+        let handle = try FileHandle(forWritingTo: trace)
+        defer { try? handle.close() }
+        try handle.seekToEnd()
+        try handle.write(contentsOf: data)
+    } catch {
+        fail("Could not record evaluation invocation: \(error)", code: 2)
+    }
+}
