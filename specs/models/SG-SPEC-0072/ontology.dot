digraph ontology {
  graph [rankdir=LR, bgcolor="#ffffff", pad=0.35, nodesep=0.35, ranksep=0.7,
    fontname="Helvetica", fontsize=18, labelloc=t, label="org.0al.specgraph.local.contextcase@0.2.0"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
    color="#94a3b8", fontcolor="#0f172a", fillcolor="#eff6ff", margin="0.16,0.1"];
  edge [fontname="Helvetica", fontsize=9, color="#64748b", fontcolor="#334155", arrowsize=0.7];
  "classes/contextcase:CheckResult" [label="«class»\ncontextcase:CheckResult\ncheck: string\ndetail: string\noutcome: string", fillcolor="#dbeafe"];
  "classes/contextcase:ContextVerificationCase" [label="«class»\ncontextcase:ContextVerificationCase\nexpectedOutcome: string", fillcolor="#dbeafe"];
  "classes/contextcase:CheckResult" -> "classes/contextcase:CheckResult" [label="closureUsesMemberCheck [0..1]", style=solid, arrowhead=normal];
  "classes/contextcase:CheckResult" -> "external/classes/sg:ValueObject" [label="extends", style=solid, arrowhead=empty];
  "classes/contextcase:ContextVerificationCase" -> "classes/contextcase:CheckResult" [label="caseIncludesCheck [2..2]", style=solid, arrowhead=normal];
  "classes/contextcase:ContextVerificationCase" -> "external/classes/sgcore:Requirement" [label="caseValidatesRequirement [1..1]", style=solid, arrowhead=normal];
  "classes/contextcase:ContextVerificationCase" -> "external/classes/sgcore:Test" [label="extends", style=solid, arrowhead=empty];
  subgraph cluster_external {
    label="External references (declarations not loaded)";
    fontsize=11; color="#cbd5e1"; style=dashed;
  "external/classes/sg:ValueObject" [label="«external reference»\nsg:ValueObject\nspecgraph.foundation@0.1.0", fillcolor="#f1f5f9", style="rounded,dashed,filled"];
  "external/classes/sgcore:Requirement" [label="«external reference»\nsgcore:Requirement\norg.0al.specgraph.core@0.1.0", fillcolor="#f1f5f9", style="rounded,dashed,filled"];
  "external/classes/sgcore:Test" [label="«external reference»\nsgcore:Test\norg.0al.specgraph.core@0.1.0", fillcolor="#f1f5f9", style="rounded,dashed,filled"];
  }
}
